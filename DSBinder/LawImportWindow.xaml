<Window x:Class="DSBinder.LawImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Імпорт законки"
        Width="1000" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Імпорт законки" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.WindowClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Height="44" Click="Cancel_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,4,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Ліва частина: текст -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="ТЕКСТ ЗАКОНОДАВСТВА" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}" Padding="12,6" Click="OpenFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Відкрити файл (.txt, .docx, .json)"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="SourceBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                             TextChanged="SourceBox_TextChanged"
                             Tag="Вставте сюди текст кодексу (Ctrl+V) або відкрийте файл.&#10;&#10;Приклад формату:&#10;8.6 [Р] Незаконне придбання… зброї.&#10;Пріоритет розшуку: 3.&#10;Карається позбавленням волі на строк до 30 місяців…&#10;Коментар: Список забороненого озброєння…"/>
                    <TextBlock x:Name="FileInfoText" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="2,8,0,0"
                               Text="Статті розпізнаються за номером на початку рядка: «8.6 …», «Стаття 12 …». Рядок-заголовок «Кримінальний кодекс» перемикає кодекс."
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Права частина: налаштування і перегляд -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="ДО ЯКОГО КОДЕКСУ" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel x:Name="PresetPanel" Margin="0,0,0,4"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ShortBox" Tag="КК" MaxLength="8" FontWeight="Bold" TextChanged="CodeBox_TextChanged"
                                     ToolTip="Абревіатура — показується біля кожної статті"/>
                            <TextBox x:Name="NameBox" Grid.Column="2" Tag="Кримінальний кодекс" MaxLength="80" TextChanged="CodeBox_TextChanged"
                                     ToolTip="Повна назва кодексу"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingDesc}" FontSize="11.5" Margin="0,6,0,0"
                                   Text="Використовується для статей, перед якими в тексті немає заголовка кодексу."/>

                        <Grid Margin="0,16,0,0">
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="Замінити існуючі статті" Style="{StaticResource SettingTitle}" FontSize="13"/>
                                <TextBlock Style="{StaticResource SettingDesc}" FontSize="11.5"
                                           Text="Старі статті цього кодексу буде видалено. Вимкніть, щоб лише додати/оновити."/>
                            </StackPanel>
                            <CheckBox x:Name="ReplaceSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,12"/>
                        <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="Bold" Text="Розпізнано: 0 статей"/>
                        <ItemsControl x:Name="GroupsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border CornerRadius="6" Padding="7,2" Background="{Binding Background}">
                                            <TextBlock Text="{Binding Short}" FontWeight="Bold" FontSize="12" Foreground="{Binding Foreground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ПЕРЕГЛЯД" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                        <ListBox x:Name="PreviewList" Background="Transparent" BorderThickness="0" Padding="10,6"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11" Foreground="{Binding CodeBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- Футер -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <TextBlock x:Name="WarningText" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,320,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Style="{StaticResource Btn.Secondary}" Click="Cancel_Click" Margin="0,0,10,0"/>
                        <Button x:Name="ImportButton" Style="{StaticResource Btn.Primary}" Click="Import_Click" Padding="20,9" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ImportButtonText" Text="Імпортувати"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
