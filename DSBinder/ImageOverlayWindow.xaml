<Window x:Class="DSBinder.ImageOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSBinder Image"
        Width="420" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Border x:Name="ImageBorder" Background="#CC0C0E12" BorderBrush="Transparent"
                BorderThickness="1.5" CornerRadius="10" Padding="3"
                MouseLeftButtonDown="Root_MouseLeftButtonDown"
                MouseMove="Root_MouseMove"
                MouseLeftButtonUp="Root_MouseLeftButtonUp">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Завантаження…" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="10"/>
                <Image x:Name="OverlayImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,3,3" Cursor="SizeNWSE" Visibility="Collapsed" DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 16,5 L 5,16 M 16,10 L 10,16" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
