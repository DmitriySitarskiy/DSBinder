<Window x:Class="DSBinder.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSBinder Overlay"
        Width="280" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Border x:Name="Root" CornerRadius="12" Background="#E60C0E12"
                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="12,10,12,10"
                MouseLeftButtonDown="Root_MouseLeftButtonDown"
                MouseMove="Root_MouseMove"
                MouseLeftButtonUp="Root_MouseLeftButtonUp">
            <StackPanel>
                <!-- Заголовок -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="DS" FontSize="9" FontWeight="Black" Foreground="{StaticResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DSBinder" Margin="8,0,0,0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="9" Padding="8,2"
                            Background="{StaticResource SuccessSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="УВІМК" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="ActivityText" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                <Border x:Name="ListSeparator" Height="1" Background="#1AFFFFFF" Margin="0,9,0,6"/>

                <ItemsControl x:Name="BindsItems" Grid.IsSharedSizeScope="True" FontSize="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#24F5A524" CornerRadius="4" Padding="6,1" Margin="0,0,10,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KeyDisplay}" FontFamily="{StaticResource MonoFont}"
                                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Foreground="#E0E4EA"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Немає активних біндів" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" Visibility="Collapsed"/>

                <TextBlock x:Name="EditHint" Visibility="Collapsed" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"
                           Text="Перетягніть панель мишею. Кут праворуч унизу — ширина. Повторне натискання гарячої клавіші — готово."/>
            </StackPanel>
        </Border>

        <Thumb x:Name="ResizeGrip" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,2,2" Cursor="SizeWE" Visibility="Collapsed" DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 14,4 L 4,14 M 14,9 L 9,14" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
