<Window x:Class="DSBinder.QuickLawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DSBinder.Controls"
        Title="DSBinder — законодавство"
        Width="720" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="14" Background="#F20C0E12" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid Margin="18,14,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Законодавство" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                        HorizontalAlignment="Right" Click="Close_Click" ToolTip="Закрити (Esc)"/>
            </Grid>

            <ctl:LawSearchView x:Name="Search" Grid.Row="1" IsCompact="True"/>

            <TextBlock Grid.Row="2" Margin="2,8,0,0" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                       Text="Enter — скопіювати посилання · Shift+Enter / Ctrl+C у списку — повний текст · Esc — повернутись у гру"/>
        </Grid>
    </Border>
</Window>
