<UserControl x:Class="DSBinder.Controls.LawSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DSBinder.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Рядок пошуку -->
        <Grid Grid.Row="0">
            <TextBox x:Name="SearchBox" FontSize="15" Padding="42,11,40,11"
                     Tag="Пошук: номер статті, слово або його частина (напр. «8.6», «зброя», «викрад»)…"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextDimBrush}"
                       Margin="15,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
            <Button x:Name="ClearButton" Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                    HorizontalAlignment="Right" Margin="0,0,7,0" Visibility="Collapsed" Click="Clear_Click" ToolTip="Очистити (Esc)"/>
        </Grid>

        <!-- Фільтр кодексів -->
        <WrapPanel x:Name="CodePanel" Grid.Row="1" Margin="0,12,0,0"/>

        <!-- Статус -->
        <Grid Grid.Row="2" Margin="2,4,0,8">
            <TextBlock x:Name="ResultInfo" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
            <TextBlock x:Name="CopiedInfo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                       HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed"/>
        </Grid>

        <!-- Результати -->
        <ListBox x:Name="ResultsList" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource PlainListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 KeyboardNavigation.TabNavigation="Once"
                 PreviewKeyDown="ResultsList_PreviewKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Style="{StaticResource BindCard}" Padding="16,13" Margin="0,0,6,8"
                            MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <!-- Шапка: кодекс, номер, мітки, розшук -->
                                <WrapPanel Orientation="Horizontal">
                                    <Border CornerRadius="6" Padding="7,2" Background="{Binding CodeBackground}" Margin="0,0,8,4"
                                            ToolTip="{Binding CodeName}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CodeShort}" FontWeight="Bold" FontSize="12" Foreground="{Binding CodeBrush}"/>
                                    </Border>
                                    <TextBlock ctl:Highlight.Text="{Binding NumberText}" ctl:Highlight.Query="{Binding Query}"
                                               FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,8,4"
                                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding TagsText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <Border CornerRadius="10" Padding="8,2" Margin="0,0,8,4" Background="{Binding PriorityBackground}"
                                            VerticalAlignment="Center" ToolTip="Пріоритет розшуку"
                                            Visibility="{Binding HasPriority, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="10" Foreground="{Binding PriorityBrush}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding PriorityText}" FontSize="11" FontWeight="Bold" Foreground="{Binding PriorityBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Назва -->
                                <TextBlock ctl:Highlight.Text="{Binding Title}" ctl:Highlight.Query="{Binding Query}"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextBrush}"/>

                                <!-- Покарання -->
                                <Grid Margin="0,8,0,0" Visibility="{Binding HasPunishment, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1" ctl:Highlight.Text="{Binding Punishment}" ctl:Highlight.Query="{Binding Query}"
                                               TextWrapping="Wrap" FontSize="13" Foreground="#D6DAE1"/>
                                </Grid>

                                <!-- Коментар -->
                                <Grid Margin="0,6,0,0" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1" ctl:Highlight.Text="{Binding Comment}" ctl:Highlight.Query="{Binding Query}"
                                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>

                                <!-- Інше -->
                                <TextBlock ctl:Highlight.Text="{Binding Extra}" ctl:Highlight.Query="{Binding Query}"
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="22,6,0,0"
                                           Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding Chapter}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasChapter, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,-4,-6,0">
                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8C8;" Tag="{Binding}" Click="CopyShort_Click"
                                        ToolTip="Скопіювати посилання (напр. «ст. 8.6 КК»)"/>
                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8A5;" Tag="{Binding}" Click="CopyFull_Click"
                                        ToolTip="Скопіювати повний текст статті"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Порожні стани -->
        <StackPanel x:Name="EmptyState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyIcon" Text="&#xE82D;" Style="{StaticResource Icon}" FontSize="24"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock x:Name="EmptyDesc" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
